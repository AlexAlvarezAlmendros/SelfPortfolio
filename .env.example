# Umami analytics — self-hosted instance.
# Copy to `.env` for local testing, and set the same vars in the Vercel project
# of THIS site (not the Umami one). With these unset the site renders no tracker
# at all, which is what we want in dev and in CI.

# Full URL of the tracker script served by your Umami instance.
PUBLIC_UMAMI_SRC="https://analytics.alexalvarez.dev/script.js"

# Website ID that Umami generates when you add the site in its dashboard.
PUBLIC_UMAMI_WEBSITE_ID=""

# Hosts allowed to send data, comma separated. Keeps Vercel preview deploys and
# localhost out of the production numbers.
PUBLIC_UMAMI_DOMAINS="www.alexalvarez.dev"

# Session replay + heatmaps. "true" loads recorder.js, but only after the
# visitor accepts the consent banner. Leave empty to disable both entirely.
PUBLIC_UMAMI_REPLAY=""
