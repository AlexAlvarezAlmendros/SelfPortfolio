# Copy to .env.local (gitignored) to test publishing from your machine.
# In CI these live in GitHub → Settings → Secrets and variables → Actions.
# Leave a network's block commented out and that network is simply skipped.

# --- Bluesky -----------------------------------------------------------------
# App password from https://bsky.app/settings/app-passwords — NOT your login.
# BLUESKY_HANDLE=alexalvarez.dev
# BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Mastodon ----------------------------------------------------------------
# Preferences -> Development -> New application, scope write:statuses.
# MASTODON_INSTANCE=https://mastodon.social
# MASTODON_ACCESS_TOKEN=

# --- Threads -----------------------------------------------------------------
# THREADS_ACCESS_TOKEN=

# --- LinkedIn ----------------------------------------------------------------
# LINKEDIN_ACCESS_TOKEN=
# Date the token was issued; the script warns 10 days before the 60-day expiry.
# LINKEDIN_TOKEN_ISSUED=2026-07-31

# --- X -----------------------------------------------------------------------
# Costs ~$0.20 per post containing a link.
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=
