---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import WorkListView from '../../components/views/WorkListView.astro';
import { useTranslations } from '../../i18n/utils';
import { workListJsonLd } from '../../lib/jsonld';
import { projectShot } from '../../lib/project-thumbs';

const lang = 'es' as const;
const t = useTranslations(lang);
const url = new URL('/work', Astro.site).href;

const projects = (await getCollection('projects', (e) => e.data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order,
);
const jsonLd = workListJsonLd({
  lang,
  url,
  name: t('work.title'),
  description: t('meta.work.desc'),
  projects: projects.map((p) => ({
    name: p.data.name,
    url: new URL(`/work/${p.data.slug}`, Astro.site).href,
    description: p.data.tagline,
    image: projectShot[p.data.slug] ?? undefined,
  })),
});
---
<Layout
  lang={lang}
  path="/work"
  title={t('meta.work.title')}
  description={t('meta.work.desc')}
  jsonLd={jsonLd}
>
  <WorkListView lang={lang} />
</Layout>
